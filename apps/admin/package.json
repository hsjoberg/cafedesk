    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.19"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "5",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  }
}
